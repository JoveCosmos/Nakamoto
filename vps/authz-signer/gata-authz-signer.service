[Unit]
Description=GATA authz signer (AtomOne autopilot redelegations, own key)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=gata-signer
Group=gata-signer
WorkingDirectory=/opt/gata-authz-signer
EnvironmentFile=-/etc/gata/authz-signer.env
LoadCredentialEncrypted=authz_mnemonic:/etc/gata/authz_mnemonic.cred
LoadCredentialEncrypted=authz_secret:/etc/gata/authz_secret.cred
ExecStart=/usr/bin/node /opt/gata-authz-signer/server.mjs
Restart=on-failure
RestartSec=10
SuccessExitStatus=78

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
