[Unit]
Description=AtomOne Autopilot signer (authz redelegations and restakes, own key and user)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=atomone-autopilot
Group=atomone-autopilot
WorkingDirectory=/opt/atomone-autopilot-signer
EnvironmentFile=-/etc/atomone-autopilot/signer.env
LoadCredentialEncrypted=autopilot_mnemonic:/etc/atomone-autopilot/mnemonic.cred
LoadCredentialEncrypted=autopilot_secret:/etc/atomone-autopilot/secret.cred
ExecStart=/usr/bin/node /opt/atomone-autopilot-signer/server.mjs
# the per-delegator day (day.json) survives a restart: /var/lib/atomone-autopilot-signer, owned by the service user
StateDirectory=atomone-autopilot-signer
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10
SuccessExitStatus=78

# Proven with node + cosmjs 0.39 as a systemd unit (2026-09-28). NOT MemoryDenyWriteExecute:
# it kills node the moment V8's JIT compiles hot code. SystemCallErrorNumber=EPERM lets
# libuv fall back when it probes io_uring instead of the filter killing the process.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
