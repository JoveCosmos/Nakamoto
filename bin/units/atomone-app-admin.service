[Unit]
Description=AtomOne Autopilot admin console API (loopback 8790, behind nginx /admin-api/)
After=network-online.target

[Service]
Type=simple
User=atomone-app
Group=atomone-app
EnvironmentFile=/etc/gata/atomone-app-alerts.env
EnvironmentFile=-/etc/gata/atomone-app-admin.env
ExecStart=/usr/bin/python3 /srv/atomone-app/bin/adminapi.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6
# red team 2026-10-01: writes only its own state (admin-secret, admin-<net>.json); the shared state dir is read only
Environment=ADMIN_STATE_DIR=/srv/atomone-app/state/admin
ReadWritePaths=/srv/atomone-app/state/admin
MemoryMax=256M
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# audit 2026-09-30: as tight as the faucet's (it needs no capability, no clock, no other process)
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
